{
  "name": "centre-cfs",
  "version": "2.0.0",
  "private": true,
  "description": "Site trilingue du Centre CFS : générateur Python, Worker Cloudflare, moteur Google Sheets, comptes Supabase.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "python3 site/build.py",
    "build:dev": "python3 site/build.py --dev",
    "import:client": "python3 site/tools/import_client.py",
    "vendor": "node scripts/vendor.js",
    "dev": "node scripts/dev.js",
    "mock:sheet": "node scripts/mock-sheet.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:py": "python3 -m pytest site/tests -q",
    "test:e2e": "playwright test",
    "test:all": "npm run test && npm run test:py && npm run check",
    "check": "python3 site/tools/check_i18n.py && python3 site/tools/check_links.py",
    "lint": "eslint . && prettier --check \"worker/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "format": "prettier --write \"worker/**/*.js\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "eval:chatbot": "node scripts/eval-chatbot.js",
    "guide:pdf": "node scripts/guide-pdf.js",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "jose": "6.2.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@supabase/supabase-js": "2.119.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "wrangler": "4.158.0"
  }
}
