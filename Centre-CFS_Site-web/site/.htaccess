# Centre CFS — configuration Apache (OVH, Combell, one.com, o2switch…)
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS + domaine sans www
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://centrecfs.be%{REQUEST_URI} [L,R=301]

  # Anciennes adresses WordPress → nouvelles pages (préserve le référencement)
  RewriteRule ^blog/?$ /actualites/ [L,R=301]
  RewriteRule ^news/?$ /actualites/ [L,R=301]
  RewriteRule ^customer-dashboard/?.*$ /contact/ [L,R=301]
  RewriteRule ^(checkout|cart|panier|mon-compte|my-account)/?.*$ /agenda/ [L,R=301]
  RewriteRule ^wp-content/uploads/.*\.(pdf)$ /formations/ [L,R=301,NC]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) - [F,L]

  # Le fichier de configuration du formulaire n'est jamais servi
  RewriteRule ^api/(config|config\.sample|catalogue)\.php$ - [F,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

  # Cache long pour les fichiers versionnés, court pour le HTML
  <FilesMatch "\.(woff2|svg|png|jpg|jpeg|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/plain application/manifest+json
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
